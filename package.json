{
  "name": "brevity",
  "displayName": "Brevity",
  "description": "Automatically reduces token-heavy command output for GitHub Copilot sessions.",
  "version": "0.0.1",
  "publisher": "EmantTools",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emantous/Brevity.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "brevity.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "brevity.status",
        "title": "Brevity: Show Status"
      },
      {
        "command": "brevity.enable",
        "title": "Brevity: Enable"
      },
      {
        "command": "brevity.emergencyDisable",
        "title": "Brevity: Emergency Disable"
      },
      {
        "command": "brevity.retry",
        "title": "Brevity: Retry Tools"
      },
      {
        "command": "brevity.disable",
        "title": "Brevity: Disable"
      },
      {
        "command": "brevity.uninstall",
        "title": "Brevity: Uninstall"
      },
      {
        "command": "brevity.metrics",
        "title": "Brevity: Show Local Metrics"
      },
      {
        "command": "brevity.clearMetrics",
        "title": "Brevity: Clear Local Metrics"
      }
    ],
    "configuration": {
      "title": "Brevity",
      "properties": {
        "brevity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically manage all enabled Brevity token-reduction tools."
        },
        "brevity.killSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Emergency kill switch that disables rewriting and removes the Brevity hook."
        },
        "brevity.rolloutStage": {
          "type": "string",
          "enum": ["preview", "staged", "general"],
          "default": "general",
          "description": "Local rollout stage label used for operational status and release checks."
        },
        "brevity.tools.commands.allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "git", "npm", "pnpm", "yarn", "cargo",
            "pytest", "mvn", "gradle", "dotnet", "go", "phpunit",
            "docker", "kubectl", "aws", "az", "gcloud"
            ,"ls", "find", "grep", "rg", "du", "df", "stat", "file", "pwd", "tree",
            "curl", "wget"
          ],
          "description": "Command families eligible for command-output reduction tools."
        },
        "brevity.tools.commands.excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Exact prefixes or regular expressions beginning with ^ that Brevity must not rewrite."
        },
        "brevity.tools.commands.overrides": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "boolean" },
          "description": "Per-command overrides such as {\"git diff\": true}; use only after measuring the command output."
        },
        "brevity.allowBypass": {
          "type": "boolean",
          "default": true,
          "description": "Document and preserve raw-output bypass guidance for tools that support it."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "test:unit": "node --test test/unit/*.test.js",
    "test:smoke": "bash test/rtk-copilot-hook-smoke.sh",
    "pilot": "node scripts/rtk-pilot.js",
    "benchmark:rtk": "node scripts/rtk-pilot.js",
    "benchmark:final": "node scripts/rtk-pilot.js --real",
    "test:all": "npm run lint && npm run test:unit && npm test && npm run test:smoke",
    "package": "vsce package",
    "package:check": "node scripts/check-vsix-contents.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.5.0",
    "globals": "^16.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "dependencies": {
    "tar": "^7.5.23",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
