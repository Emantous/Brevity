{
  "name": "brevity",
  "displayName": "Brevity",
  "description": "Automatically reduces token-heavy command output for GitHub Copilot sessions.",
  "version": "0.0.1",
  "publisher": "EmantTools",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emantous/Brevity.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "brevity.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "brevity.rtkStatus",
        "title": "Brevity: Show RTK Runtime Status"
      },
      {
        "command": "brevity.rtkRetry",
        "title": "Brevity: Retry RTK Runtime Setup"
      },
      {
        "command": "brevity.rtkDisable",
        "title": "Brevity: Disable RTK and Remove Copilot Hook"
      },
      {
        "command": "brevity.rtkUninstall",
        "title": "Brevity: Uninstall Managed RTK Runtime"
      }
    ],
    "configuration": {
      "title": "Brevity",
      "properties": {
        "brevity.rtk.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically manage the RTK runtime used for command output compression."
        },
        "brevity.rtk.commands.allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["git", "npm", "pnpm", "yarn", "cargo"],
          "description": "Command families Brevity may rewrite through RTK."
        },
        "brevity.rtk.commands.excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Exact prefixes or regular expressions beginning with ^ that Brevity must not rewrite."
        },
        "brevity.rtk.commands.overrides": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "boolean" },
          "description": "Per-command overrides such as {\"git diff\": true}; use only after measuring the command output."
        },
        "brevity.rtk.allowBypass": {
          "type": "boolean",
          "default": true,
          "description": "Document and preserve the RTK bypass command for raw, uncompressed output."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "test:unit": "node --test test/unit/*.test.js",
    "test:smoke": "bash test/rtk-copilot-hook-smoke.sh",
    "pilot": "node scripts/rtk-pilot.js",
    "test:all": "npm run lint && npm run test:unit && npm test && npm run test:smoke",
    "package": "vsce package",
    "package:check": "node scripts/check-vsix-contents.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.5.0",
    "globals": "^16.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "dependencies": {
    "tar": "^7.5.23",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
